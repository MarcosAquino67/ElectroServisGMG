<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="comprobante_orden" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="nroOrden" class="java.lang.String"/>
    <parameter name="cliente" class="java.lang.String"/>
    <parameter name="equipo" class="java.lang.String"/>
    <parameter name="marca" class="java.lang.String"/>
    <parameter name="falla" class="java.lang.String"/>
    <parameter name="fecha" class="java.lang.String"/>
    <parameter name="estado" class="java.lang.String"/>
    <title>
        <band height="110">
            <staticText><reportElement forecolor="#FFFFFF" x="0" y="0" width="555" height="30" mode="Opaque" backcolor="#2C3E50"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="16" isBold="true"/></textElement><text><![CDATA[ELECTROSERVIS G.M.G - Comprobante de Recepcion]]></text></staticText>
            <staticText><reportElement x="0" y="35" width="555" height="15"/><textElement textAlignment="Center"><font size="8"/></textElement><text><![CDATA[Servicio Tecnico Especializado - Laboratorio de Reparacion]]></text></staticText>
            <textField><reportElement x="0" y="60" width="185" height="20"/><textFieldExpression><![CDATA["Orden Nro: " + $P{nroOrden}]]></textFieldExpression></textField>
            <textField><reportElement x="185" y="60" width="185" height="20"/><textFieldExpression><![CDATA["Fecha: " + $P{fecha}]]></textFieldExpression></textField>
            <textField><reportElement x="370" y="60" width="185" height="20"/><textFieldExpression><![CDATA["Estado: " + $P{estado}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="85" width="555" height="1"/></line>
        </band>
    </title>
    <detail>
        <band height="90">
            <textField><reportElement x="0" y="0" width="555" height="20"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA["Cliente: " + $P{cliente}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="20" width="277" height="20"/><textFieldExpression><![CDATA["Equipo: " + $P{equipo}]]></textFieldExpression></textField>
            <textField><reportElement x="278" y="20" width="277" height="20"/><textFieldExpression><![CDATA["Marca: " + $P{marca}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="0" y="40" width="555" height="20"/><textFieldExpression><![CDATA["Falla reportada: " + $P{falla}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="70" width="555" height="1"/></line>
            <staticText><reportElement x="0" y="75" width="555" height="15"/><textElement textAlignment="Center"><font size="7" isItalic="true"/></textElement><text><![CDATA[Conserve este comprobante para retirar su equipo. Plazo estimado sera comunicado por el tecnico.]]></text></staticText>
        </band>
    </detail>
</jasperReport>
