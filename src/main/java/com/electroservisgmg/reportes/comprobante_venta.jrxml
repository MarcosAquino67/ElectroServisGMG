<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="comprobante_venta" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="nroVenta" class="java.lang.String"/>
    <parameter name="cliente" class="java.lang.String"/>
    <parameter name="fecha" class="java.lang.String"/>
    <parameter name="total" class="java.lang.String"/>
    <parameter name="iva" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precioUnitario" class="java.lang.Double"/>
    <field name="subtotal" class="java.lang.Double"/>
    <title>
        <band height="100">
            <staticText><reportElement x="0" y="0" width="555" height="30"/><textElement textAlignment="Center"><font size="16" isBold="true"/></textElement><text><![CDATA[ELECTROSERVIS G.M.G - Ticket de Venta]]></text></staticText>
            <textField><reportElement x="0" y="35" width="185" height="20"/><textFieldExpression><![CDATA["Venta Nro: " + $P{nroVenta}]]></textFieldExpression></textField>
            <textField><reportElement x="185" y="35" width="185" height="20"/><textFieldExpression><![CDATA["Cliente: " + $P{cliente}]]></textFieldExpression></textField>
            <textField><reportElement x="370" y="35" width="185" height="20"/><textFieldExpression><![CDATA["Fecha: " + $P{fecha}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="65" width="200" height="15"/><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement x="200" y="65" width="80" height="15"/><text><![CDATA[Cant]]></text></staticText>
            <staticText><reportElement x="280" y="65" width="120" height="15"/><text><![CDATA[P.Unit]]></text></staticText>
            <staticText><reportElement x="400" y="65" width="120" height="15"/><text><![CDATA[Subtotal]]></text></staticText>
        </band>
    </title>
    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="200" height="20"/><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField><reportElement x="200" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="280" y="0" width="120" height="20"/><textFieldExpression><![CDATA[$F{precioUnitario}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="400" y="0" width="120" height="20"/><textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField>
        </band>
    </detail>
    <summary>
        <band height="78">
            <staticText><reportElement x="280" y="2" width="120" height="18"/><textElement textAlignment="Right"></textElement><text><![CDATA[IVA 10% incl.:]]></text></staticText>
            <textField><reportElement x="400" y="2" width="120" height="18"/><textFieldExpression><![CDATA[$P{iva}]]></textFieldExpression></textField>
            <staticText><reportElement x="280" y="22" width="120" height="20"/><textElement textAlignment="Right"><font isBold="true"/></textElement><text><![CDATA[TOTAL:]]></text></staticText>
            <textField><reportElement x="400" y="22" width="120" height="20"/><textElement><font isBold="true" size="12"/></textElement><textFieldExpression><![CDATA[$P{total}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="48" width="555" height="16"/><textElement textAlignment="Center"><font size="8" isItalic="true"/></textElement><text><![CDATA[Precios en guaranies con IVA 10% incluido.]]></text></staticText>
        </band>
    </summary>
</jasperReport>
