<?xml version="1.0" encoding="UTF-8"?>
<!--
  Factura Electronica (SIFEN - Paraguay).
  Layout calcado de la factura real de la empresa:
    - bloque emisor (logo + razon social + direccion + actividades) a la izquierda
    - bloque timbrado / RUC / FACTURA ELECTRONICA / numeracion a la derecha
    - datos del cliente, grilla de items, totales, CDC y textos legales
  Colores: gris #EBEBEB (encabezado de tabla y filas de totales),
           celeste #CEDAF0 (banda del CDC).
  Medidas tomadas de la factura original (pagina 595 x 609 pt).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="factura_electronica"
              pageWidth="595" pageHeight="609" columnWidth="568"
              leftMargin="14" rightMargin="13" topMargin="0" bottomMargin="14">

    <!-- ===================== parametros ===================== -->
    <parameter name="razonSocial" class="java.lang.String"/>
    <parameter name="logo" class="java.io.InputStream"/>
    <parameter name="direccionEmpresa" class="java.lang.String"/>
    <parameter name="ciudadTelefono" class="java.lang.String"/>
    <parameter name="actividades" class="java.lang.String"/>
    <parameter name="timbrado" class="java.lang.String"/>
    <parameter name="vigencia" class="java.lang.String"/>
    <parameter name="ruc" class="java.lang.String"/>
    <parameter name="nroFactura" class="java.lang.String"/>
    <parameter name="fechaEmision" class="java.lang.String"/>
    <parameter name="tipoTransaccion" class="java.lang.String"/>
    <parameter name="condicionMarcas" class="java.lang.String"/>
    <parameter name="rucCliente" class="java.lang.String"/>
    <parameter name="cliente" class="java.lang.String"/>
    <parameter name="direccionCliente" class="java.lang.String"/>
    <parameter name="telefonoCliente" class="java.lang.String"/>
    <parameter name="emailCliente" class="java.lang.String"/>
    <parameter name="totalDescuento" class="java.lang.Double"/>
    <parameter name="totalExenta" class="java.lang.Double"/>
    <parameter name="total5" class="java.lang.Double"/>
    <parameter name="total10" class="java.lang.Double"/>
    <parameter name="totalOperacion" class="java.lang.Double"/>
    <parameter name="iva5" class="java.lang.Double"/>
    <parameter name="iva10" class="java.lang.Double"/>
    <parameter name="totalIva" class="java.lang.Double"/>
    <parameter name="cdc" class="java.lang.String"/>

    <!-- ===================== detalle (una fila por producto) ===================== -->
    <field name="codigo" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="precioUnitario" class="java.lang.Double"/>
    <field name="descuento" class="java.lang.Double"/>
    <field name="valorExenta" class="java.lang.Double"/>
    <field name="valor5" class="java.lang.Double"/>
    <field name="valor10" class="java.lang.Double"/>

    <!-- ===================== recuadro del documento ===================== -->
    <background>
        <band height="595">
            <rectangle>
                <reportElement x="0" y="20" width="568" height="565" forecolor="#000000" mode="Transparent"/>
                <graphicElement/>
            </rectangle>
        </band>
    </background>

    <!-- ===================== encabezado + datos del cliente ===================== -->
    <title>
        <band height="279">

            <!-- emisor (izquierda) -->
            <image onErrorType="Blank">
                <reportElement x="145" y="24" width="44" height="44"/>
                <imageExpression class="java.io.InputStream"><![CDATA[$P{logo}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="0" y="70" width="323" height="14"/>
                <textElement textAlignment="Center"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["de " + $P{razonSocial}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="84" width="323" height="26"/>
                <textElement textAlignment="Center"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{direccionEmpresa}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="107" width="323" height="14"/>
                <textElement textAlignment="Center"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{ciudadTelefono}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="122" width="323" height="42"/>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{actividades}]]></textFieldExpression>
            </textField>

            <!-- timbrado / RUC (derecha) -->
            <line><reportElement x="322" y="20" width="1" height="151" forecolor="#000000"/></line>
            <textField>
                <reportElement x="322" y="63" width="245" height="15"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["TIMBRADO N° " + $P{timbrado}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="322" y="76" width="245" height="15"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Fecha Inicio Vigencia: " + $P{vigencia}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="322" y="89" width="245" height="15"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["RUC " + $P{ruc}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="322" y="102" width="245" height="15"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[FACTURA ELECTRÓNICA]]></text>
            </staticText>
            <textField>
                <reportElement x="322" y="115" width="245" height="15"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nroFactura}]]></textFieldExpression>
            </textField>

            <!-- linea de cierre del encabezado -->
            <line><reportElement x="0" y="171" width="568" height="1" forecolor="#000000"/></line>

            <!-- datos del cliente -->
            <staticText><reportElement x="8" y="181" width="90" height="12"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Fecha de emisión:]]></text></staticText>
            <textField><reportElement x="95" y="181" width="200" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$P{fechaEmision}]]></textFieldExpression></textField>
            <staticText><reportElement x="312" y="181" width="105" height="12"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Tipo de transacción:]]></text></staticText>
            <textField><reportElement x="417" y="181" width="151" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$P{tipoTransaccion}]]></textFieldExpression></textField>

            <staticText><reportElement x="8" y="197" width="160" height="12"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[RUC/Documento de Identidad N°:]]></text></staticText>
            <textField><reportElement x="165" y="197" width="140" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$P{rucCliente}]]></textFieldExpression></textField>
            <staticText><reportElement x="312" y="197" width="100" height="12"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Condición de venta:]]></text></staticText>
            <textField><reportElement x="415" y="197" width="153" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$P{condicionMarcas}]]></textFieldExpression></textField>

            <staticText><reportElement x="8" y="213" width="115" height="12"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Nombre o Razón Social:]]></text></staticText>
            <textField><reportElement x="121" y="213" width="447" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$P{cliente}]]></textFieldExpression></textField>

            <staticText><reportElement x="8" y="229" width="50" height="12"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Dirección:]]></text></staticText>
            <textField><reportElement x="60" y="229" width="250" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$P{direccionCliente}]]></textFieldExpression></textField>

            <staticText><reportElement x="8" y="245" width="50" height="12"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Teléfono:]]></text></staticText>
            <textField><reportElement x="60" y="245" width="250" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$P{telefonoCliente}]]></textFieldExpression></textField>

            <staticText><reportElement x="8" y="261" width="100" height="12"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Correo Electrónico:]]></text></staticText>
            <textField><reportElement x="105" y="261" width="463" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$P{emailCliente}]]></textFieldExpression></textField>
        </band>
    </title>

    <!-- ===================== encabezado de la grilla ===================== -->
    <columnHeader>
        <band height="43">
            <rectangle>
                <reportElement x="0" y="0" width="568" height="43" forecolor="#EBEBEB" backcolor="#EBEBEB" mode="Opaque"/>
            </rectangle>

            <staticText><reportElement x="358" y="0" width="210" height="23"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[VALOR DE VENTA]]></text></staticText>

            <staticText><reportElement x="0" y="0" width="41" height="43"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[COD.]]></text></staticText>
            <staticText><reportElement x="41" y="0" width="50" height="43"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[CANTIDAD]]></text></staticText>
            <staticText><reportElement x="91" y="0" width="134" height="43"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[DESCRIPCIÓN]]></text></staticText>
            <staticText><reportElement x="225" y="0" width="65" height="43"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[PRECIO UNITARIO (INCLUIDO IMPUESTO)]]></text></staticText>
            <staticText><reportElement x="290" y="0" width="68" height="43"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[DESCUENTO]]></text></staticText>
            <staticText><reportElement x="358" y="23" width="71" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[EXENTAS]]></text></staticText>
            <staticText><reportElement x="429" y="23" width="70" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[5%]]></text></staticText>
            <staticText><reportElement x="499" y="23" width="69" height="20"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[10%]]></text></staticText>

            <!-- grilla -->
            <line><reportElement x="0" y="0" width="568" height="1" forecolor="#000000"/></line>
            <line><reportElement x="0" y="42" width="568" height="1" forecolor="#000000"/></line>
            <line><reportElement x="358" y="23" width="210" height="1" forecolor="#000000"/></line>
            <line><reportElement x="41" y="0" width="1" height="43" forecolor="#000000"/></line>
            <line><reportElement x="91" y="0" width="1" height="43" forecolor="#000000"/></line>
            <line><reportElement x="225" y="0" width="1" height="43" forecolor="#000000"/></line>
            <line><reportElement x="290" y="0" width="1" height="43" forecolor="#000000"/></line>
            <line><reportElement x="358" y="0" width="1" height="43" forecolor="#000000"/></line>
            <line><reportElement x="429" y="23" width="1" height="20" forecolor="#000000"/></line>
            <line><reportElement x="499" y="23" width="1" height="20" forecolor="#000000"/></line>
        </band>
    </columnHeader>

    <!-- ===================== items ===================== -->
    <detail>
        <band height="22">
            <textField><reportElement x="3" y="0" width="37" height="21"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField><reportElement x="41" y="0" width="50" height="21"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField><reportElement x="93" y="0" width="130" height="21"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="226" y="0" width="62" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{precioUnitario}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="291" y="0" width="65" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{descuento}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="359" y="0" width="68" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{valorExenta}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="430" y="0" width="67" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{valor5}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="500" y="0" width="66" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{valor10}]]></textFieldExpression></textField>

            <!-- grilla de la fila -->
            <line><reportElement x="0" y="21" width="568" height="1" forecolor="#000000"/></line>
            <line><reportElement x="41" y="0" width="1" height="22" forecolor="#000000"/></line>
            <line><reportElement x="91" y="0" width="1" height="22" forecolor="#000000"/></line>
            <line><reportElement x="225" y="0" width="1" height="22" forecolor="#000000"/></line>
            <line><reportElement x="290" y="0" width="1" height="22" forecolor="#000000"/></line>
            <line><reportElement x="358" y="0" width="1" height="22" forecolor="#000000"/></line>
            <line><reportElement x="429" y="0" width="1" height="22" forecolor="#000000"/></line>
            <line><reportElement x="499" y="0" width="1" height="22" forecolor="#000000"/></line>
        </band>
    </detail>

    <!-- ===================== CDC + textos legales ===================== -->
    <pageFooter>
        <band height="95">
            <rectangle>
                <reportElement x="0" y="0" width="568" height="21" forecolor="#CEDAF0" backcolor="#CEDAF0" mode="Opaque"/>
            </rectangle>
            <textField>
                <reportElement x="0" y="0" width="568" height="21"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["CDC: " + $P{cdc}]]></textFieldExpression>
            </textField>

            <staticText><reportElement x="0" y="34" width="568" height="12"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[ESTE DOCUMENTO ES UNA REPRESENTACIÓN GRÁFICA DE UN DOCUMENTO ELECTRÓNICO (XML)]]></text></staticText>
            <staticText><reportElement x="8" y="48" width="552" height="12"/><textElement><font size="8"/></textElement><text><![CDATA[Información de interés del facturador electrónico emisor.]]></text></staticText>
            <staticText><reportElement x="8" y="60" width="552" height="12"/><textElement><font size="8"/></textElement><text><![CDATA[Si su documento electrónico presenta algún error, podrá solicitar dentro de las 72 horas siguientes de la emisión del presente documento,]]></text></staticText>
            <staticText><reportElement x="8" y="72" width="552" height="12"/><textElement><font size="8"/></textElement><text><![CDATA[la cancelación del mismo y la generación de un nuevo comprobante.]]></text></staticText>
        </band>
    </pageFooter>

    <!-- ===================== totales ===================== -->
    <summary>
        <band height="63">
            <rectangle>
                <reportElement x="0" y="0" width="568" height="21" forecolor="#EBEBEB" backcolor="#EBEBEB" mode="Opaque"/>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="21" width="568" height="21" forecolor="#EBEBEB" backcolor="#EBEBEB" mode="Opaque"/>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="42" width="568" height="21" forecolor="#EBEBEB" backcolor="#EBEBEB" mode="Opaque"/>
            </rectangle>

            <staticText><reportElement x="8" y="0" width="120" height="21"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[SUBTOTAL:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="291" y="0" width="65" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{totalDescuento}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="359" y="0" width="68" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{totalExenta}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="430" y="0" width="67" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{total5}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="500" y="0" width="66" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{total10}]]></textFieldExpression></textField>

            <line><reportElement x="0" y="21" width="568" height="1" forecolor="#000000"/></line>

            <staticText><reportElement x="8" y="21" width="200" height="21"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[TOTAL DE LA OPERACIÓN:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="499" y="21" width="67" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{totalOperacion}]]></textFieldExpression></textField>

            <line><reportElement x="0" y="42" width="568" height="1" forecolor="#000000"/></line>

            <staticText><reportElement x="8" y="42" width="110" height="21"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><text><![CDATA[LIQUIDACIÓN IVA:]]></text></staticText>
            <staticText><reportElement x="118" y="42" width="32" height="21"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><text><![CDATA[(5%)]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="152" y="42" width="53" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{iva5}]]></textFieldExpression></textField>
            <staticText><reportElement x="218" y="42" width="38" height="21"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><text><![CDATA[(10%)]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="258" y="42" width="65" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{iva10}]]></textFieldExpression></textField>
            <staticText><reportElement x="390" y="42" width="70" height="21"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[TOTAL IVA:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="492" y="42" width="68" height="21"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{totalIva}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>
